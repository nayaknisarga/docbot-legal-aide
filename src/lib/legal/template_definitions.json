  "howTheAppUsesThis": {
    "grid": "Render cards from documentTypes[], grouped by category.",
    "questionnaire": "For a chosen template: usesCommonQuestions (from commonQuestions[]) + its questions[], asked one at a time by the AI agent. Hide any question whose visibleWhen isn't met.",
    "reuse": "Answers keyed by fieldId; common fields carry across templates so the user isn't asked twice.",
    "generation": "Replace each mapsTo placeholder, then scan for leftover {{...}} before showing the draft.",
    "jurisdiction_guard": "Show jurisdictionWarnings for the chosen jurisdiction; if jurisdiction not in a doc's jurisdiction[], mark UNSUPPORTED."
  }
