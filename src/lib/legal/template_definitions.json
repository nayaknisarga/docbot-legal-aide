{
  "schemaVersion": "1.1",
  "description": "Full template catalogue the webapp reads to know every template and all its questions. Powers the template grid + the AI questionnaire + the live draft preview.",
  "jurisdictionsSupported": [
    "IN",
    "US"
  ],
  "disclaimer": "All content is a demo draft, not legal advice, and is not lawyer-reviewed. Must be reviewed for the chosen jurisdiction before real use.",
  "answerTypes": [
    "text",
    "long_text",
    "number",
    "money",
    "date",
    "boolean",
    "select",
    "multiselect"
  ],
  "commonQuestions": [
    {
      "fieldId": "jurisdiction",
      "label": "Which country/state's law applies?",
      "helpText": "Governs the document and where disputes are settled.",
      "answerType": "select",
      "required": true,
      "options": [
        "India",
        "US - Delaware",
        "US - California",
        "United Kingdom"
      ],
      "mapsTo": "{{jurisdiction}}"
    },
    {
      "fieldId": "effective_date",
      "label": "What date should it take effect?",
      "answerType": "date",
      "required": true,
      "mapsTo": "{{date}}"
    },
    {
      "fieldId": "party_a_name",
      "label": "First party's full legal name",
      "helpText": "Company (with entity type) or individual.",
      "answerType": "text",
      "required": true,
      "mapsTo": "{{party_a_name}}"
    },
    {
      "fieldId": "party_a_address",
      "label": "First party's address",
      "answerType": "long_text",
      "required": true,
      "mapsTo": "{{party_a_address}}"
    },
    {
      "fieldId": "party_a_signatory",
      "label": "Who signs for the first party?",
      "answerType": "text",
      "required": true,
      "mapsTo": "{{party_a_signatory}}"
    },
    {
      "fieldId": "party_b_name",
      "label": "Second party's full legal name",
      "answerType": "text",
      "required": true,
      "mapsTo": "{{party_b_name}}"
    },
    {
      "fieldId": "party_b_address",
      "label": "Second party's address",
      "answerType": "long_text",
      "required": true,
      "mapsTo": "{{party_b_address}}"
