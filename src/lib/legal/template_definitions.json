      "questions": [
        {
          "fieldId": "services",
          "label": "What work will the contractor do?",
          "answerType": "long_text",
          "required": true,
          "mapsTo": "{{project}}"
        },
        {
          "fieldId": "fee",
          "label": "What is the fee?",
          "answerType": "money",
          "required": true,
          "mapsTo": "{{fee}}"
        },
        {
          "fieldId": "payment_schedule",
          "label": "How is the fee paid?",
          "answerType": "select",
          "required": true,
          "options": [
            "Lump sum",
            "Milestone-based",
            "Monthly",
            "Hourly"
          ],
          "mapsTo": "{{payment_schedule}}"
        },
        {
          "fieldId": "creates_ip",
          "label": "Will the contractor create work/IP?",
          "answerType": "boolean",
          "required": true
        },
        {
          "fieldId": "ip_ownership",
          "label": "Who owns the created work?",
          "answerType": "select",
          "required": true,
          "options": [
            "Client owns on payment",
            "Contractor licenses to client",
            "Shared"
          ],
          "visibleWhen": {
            "fieldId": "creates_ip",
            "equals": true
          },
          "mapsTo": "{{ip_terms}}"
        },
        {
          "fieldId": "survival_years",
          "label": "Confidentiality lasts how many years after?",
          "answerType": "number",
          "required": true,
